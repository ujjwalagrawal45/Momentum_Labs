# Copy this file to .env and fill in what you use. .env is git-ignored; never share it.
# Momentum Lab itself needs NONE of these to backtest: Upstox's historical-candle endpoint is public.

# Optional: sent with Upstox data requests if set (only needed if Upstox ever gates the endpoint)
UPSTOX_ACCESS_TOKEN=

# Optional: keep data/, journal/, configs/, output/ and the settings workbook in another folder
# MOMENTUM_LAB_HOME=D:\MomentumLabData
